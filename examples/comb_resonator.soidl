// A comb-drive resonator on a 25 um SOI process: plate on four
// clamped-guided beam-pair flexures, drive + sense combs on the edges.
// Compile:  python -m soidlc.cli examples/comb_resonator.soidl

process soi25 {
  stack {
    layer METAL  { thickness = 0.52 um; material = Au }
    layer DEVICE { thickness = 25 um;   material = Si;
                   E = 169 GPa; rho = 2330 kg/m^3 }
    layer BOX    { thickness = 2 um;    material = SiO2; eps_r = 3.9 }
    layer HANDLE { thickness = 400 um;  material = Si }
  }

  masks {
    mask SOID     -> etch(DEVICE, through)
    mask TRENCH   -> etch(HANDLE, through, backside)
    mask PADMETAL -> deposit(METAL)
    mask OXIDE_RM -> etch(BOX, where = exposed)
  }

  rules {
    release {
      undercut       = 1.5 um
      max_solid_span = 30 um
      hole_size      = 5 um
      hole_pitch     = 25 um
    }
    drie {
      aspect_ratio_max = 20
      footing_margin   = 1 um
    }
  }
}

component beam_flexure(L = 200 um, w = 4 um, n_beams = 2) {
  mech port fixed, shuttle;

  // n clamped-guided beams in parallel, each k = 12*E*I/L^3 = E*t*w^3/L^3
  derive k.x = n_beams * (process.DEVICE.E * process.DEVICE.thickness * w^3) / L^3;

  geometry {
    repeat i in 0..n_beams-1 {
      beam(L, w, dir = y) at (i * (2*w + 8 um), 2 um - L/2);
    }
    // truss tying the beam tops into the shuttle (spans the beams exactly)
    beam((n_beams - 1) * (2*w + 8 um) + w, w, dir = x)
        at ((n_beams - 1) * (w + 4 um), 0);
    anchor((n_beams - 1) * (2*w + 8 um) + w + 12 um, 20 um)
        at ((n_beams - 1) * (w + 4 um), 2 um - L - 8 um);
  }

  check w >= 2 um;
  check L/w <= 100 warn "very compliant beam, check buckling";
}

component combdrive(N = 24, g = 2 um, ov = 20 um, wf = 3 um, Lf = 40 um) {
  mech port rotor;
  elec port stator, rotor_el;

  derive dCdx = N * 2 * eps0 * process.DEVICE.thickness / g;
  derive F = 0.5 * dCdx;

  geometry {
    comb(N, Lf, wf, g, ov, dir = x) at (0, 0);
  }
}

device comb_resonator {
  param f0_target = 20 kHz;
  param V_drive   = 30 V;

  inst M  = plate(300 um, 300 um) at (0, 0);
  inst S  = array(beam_flexure(L = 220 um, w = 4 um), count = 4,
                  place = corners(M));
  // combs on the left/right edges: they drive along x, the compliant axis
  // of the vertical flexure beams (the corner flexures hang above/below
  // the plate, leaving these edges clear)
  inst D1 = combdrive(N = 24) attach (rotor -> M.left);
  inst D2 = combdrive(N = 24) attach (rotor -> M.right);

  solve S.L such that f_res(M, S) == f0_target within 2%;

  net DRIVE = D1.stator;
  net SENSE = D2.stator;
  net GND   = M | S.fixed;

  isolate DRIVE from GND by trench;
  constraint released(M, S);
  constraint anchored(D1.stator, D2.stator, S.fixed);

  check stroke_max(V_drive) >= 5 um;
}
