// SOIDL standard library: suspension elements.
// Imported as:  import "flexures.soidl";
//
// Local origin of every flexure = its attachment point on the moving mass.
// Each beam reaches 2 um into the mass and runs outboard to its anchor, so an
// instance placed exactly on a mass edge is silicon-continuous with it -- the
// connectivity check enforces that overlap, so do not trim it away.

// n clamped-guided beams in parallel, stiff along y, compliant along x.
// k = n * E * t * w^3 / L^3  (clamped-guided: both ends restrained in slope)
component guided_beam(L = 200 um, w = 4 um, n_beams = 2, pitch = 12 um) {
  mech port fixed, shuttle;

  derive k.x = n_beams * (process.DEVICE.E * process.DEVICE.thickness * w^3) / L^3;

  geometry {
    repeat i in 0..n_beams-1 {
      beam(L, w, dir = y) at (i * pitch, 2 um - L/2);
    }
    // truss tying the beam tops together, spanning them exactly
    beam((n_beams - 1) * pitch + w, w, dir = x)
        at ((n_beams - 1) * pitch/2, 0);
    anchor((n_beams - 1) * pitch + w + 12 um, 20 um)
        at ((n_beams - 1) * pitch/2, 2 um - L - 8 um);
  }

  check w >= 2 um;
  check L/w <= 100 warn "very compliant beam, check buckling";
}

// A square ring of four bars: the outer drive frame of a decoupled gyroscope,
// or any structure that must surround an inner mass.  W/H are the OUTER
// dimensions; `bar` is the wall width.
//
// Horizontal bars span the full width; vertical ones are shortened by 2*bar.
// The corner silicon is therefore covered exactly once (no double-counted
// area) while the bars still abut, which is what connectivity needs to fuse
// the four into one electrical island.
component frame(W = 680 um, H = 680 um, bar = 40 um) {
  mech port body;

  geometry {
    beam(W, bar, dir = x) at (0, H/2 - bar/2);
    beam(W, bar, dir = x) at (0, bar/2 - H/2);
    beam(H - 2*bar, bar, dir = y) at (bar/2 - W/2, 0);
    beam(H - 2*bar, bar, dir = y) at (W/2 - bar/2, 0);
  }

  check bar >= 2 um;
  check W > 2*bar;
  check H > 2*bar;
}

// Folded flexure: each fold is an inboard beam and an outboard beam joined by
// a truss at the far end, so the pair acts as two guided beams in SERIES.
//
// Folding is what relieves axial stress.  A straight guided beam has to
// stretch in order to deflect, so it stiffens with amplitude and its
// resonance drifts; a folded one lets the truss take up that extension, and
// f0 stays put.
//
// The two beams are NOT the same length, and the geometry is why.  A fold's
// anchor sits beside its own attachment point -- that adjacency is the whole
// point of the topology -- so it has to stand off from the mass edge by
// `gap`, and the outboard beam therefore ends `gap` short of the inboard one.
// Two cantilevers in series add compliances:
//
//   1/k_fold = L_in^3/(E*t*w^3) + L_out^3/(E*t*w^3)
//   k_fold   = E*t*w^3 / (L_in^3 + L_out^3),   L_out = L - gap - 2 um
//
// Pretending both were L would understate the stiffness by about a quarter at
// the default proportions, and nothing in the compiler would object: the
// geometry is legal and `derive` is just arithmetic.  The FEM check on
// examples/folded_flexure_resonator.soidl is what holds this formula honest.
//
// Two more things this layout gets wrong if drawn carelessly, neither of
// which raises an error:
//   * an anchor placed on the mass side (local +y) bolts the proof mass
//     straight to the substrate -- one legal island, no LVS complaint, and a
//     resonator an order of magnitude too stiff;
//   * an outboard beam that also reaches into the mass ties the mass to the
//     anchor through a few um of silicon, with the same effect.
// Both are covered by tests in tests/test_library.py.
component folded_flexure(L = 200 um, w = 4 um, n_folds = 2,
                         truss_w = 8 um, pitch = 30 um, gap = 30 um) {
  mech port fixed, shuttle;

  derive k.x = n_folds * (process.DEVICE.E * process.DEVICE.thickness * w^3)
               / (L^3 + (L - gap - 2 um)^3);

  geometry {
    repeat i in 0..n_folds-1 {
      // inboard beam: reaches 2 um into the mass, runs out to the truss
      beam(L, w, dir = y) at (i * pitch, 2 um - L/2);
      // outboard beam: from the truss back in, stopping `gap` short of the
      // mass so it grips the anchor and nothing else
      beam(L - gap + 4 um, w, dir = y)
          at (i * pitch + pitch/2, 4 um - gap/2 - L/2 - 1 um);
      // fold truss joining the two beam tips at the far end
      beam(pitch/2 + w, truss_w, dir = x)
          at (i * pitch + pitch/4, 2 um - L - truss_w/2 + w/2);
      // anchor: grips the outboard beam only, standing clear of the mass
      anchor(16 um, gap - 6 um) at (i * pitch + pitch/2, 3 um - gap/2 - 3 um);
    }
  }

  check w >= 2 um;
  check pitch > 4*w;
  check gap > 12 um;
  check L > 3*gap;
}
